{
  "name": "smogshield-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/verify-http.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "0.21.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "firebase": "11.0.2",
    "firebase-admin": "13.0.2",
    "lucide-react": "0.460.0",
    "next": "15.1.0",
    "next-intl": "3.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "swr": "2.2.5",
    "tailwind-merge": "2.5.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@vercel/config": "^0.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "2.1.5",
    "@vitest/ui": "2.1.5",
    "autoprefixer": "10.4.20",
    "eslint": "9.15.0",
    "eslint-config-next": "15.1.0",
    "jsdom": "25.0.1",
    "msw": "2.5.0",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.0"
}
